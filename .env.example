# ─── TigerGraph Savanna ───────────────────────────────────────────────────────
TIGERGRAPH_HOST=https://your-solution-id.i.tgcloud.io
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=your_password_here
TIGERGRAPH_GRAPH_NAME=FraudGraph
TIGERGRAPH_MCP_URL=http://localhost:9000

# ─── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ─── API ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-32-char-secret
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# ─── Mock Action Service ──────────────────────────────────────────────────────
MOCK_ACTION_SERVICE_URL=http://localhost:8001
MOCK_ACTION_SERVICE_TOKEN=mock-bearer-token-dev-only

# ─── Agent ────────────────────────────────────────────────────────────────────
MAX_GRAPH_HOPS=3
CONFIDENCE_GATE_THRESHOLD=0.75
SAR_AUTO_THRESHOLD=0.90
MEMORY_SIMILARITY_TOP_K=5
